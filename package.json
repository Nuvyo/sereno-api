{
  "name": "sereno-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "npm run services:up && nest start --watch",
    "start": "nest start",
    "debug": "npm run services:up && nest start --debug --watch",
    "prod": "node dist/main",
    "lint": "eslint . --ext .ts --cache",
    "lint:fix": "eslint . --ext .ts --fix --cache",
    "lint:prettier": "prettier --check \"**/*.{json,md,yml,yaml}\"",
    "lint:prettier:fix": "prettier --write \"**/*.{json,md,yml,yaml}\"",
    "services:up": "docker compose up -d",
    "services:stop": "docker compose stop",
    "services:down": "docker compose down",
    "test": "npm run clear:test-db && cross-env NODE_ENV=test node -r ts-node/register -r tsconfig-paths/register --test --test-concurrency=1",
    "tests": "npm run clear:test-db && cross-env NODE_ENV=test node -r ts-node/register -r tsconfig-paths/register --test --test-concurrency=1 ./src/**/*.spec.ts",
    "test:cov": "c8 npm run tests",
    "tests:cov": "c8 npm run tests",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d src/core/datasources/postgres.datasource.ts",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate ./src/core/migration/Migration -d src/core/datasources/postgres.datasource.ts",
    "migration:create": "npx typeorm-ts-node-commonjs migration:create ./src/core/migration/Migration",
    "migration:new": "rm -rf dist && npm run build && npm run migration:run && npm run migration:generate",
    "clear:test-db": "node -r tsconfig-paths/register -r ts-node/register ./scripts/clear-test-db.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.4",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/helmet": "^0.0.48",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "bullmq": "^5.74.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express-useragent": "^1.0.15",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "nestjs-i18n": "^10.6.5",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.4.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.19",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.26",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-useragent": "^1.0.5",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "c8": "^11.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.0.0",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.2"
  }
}
